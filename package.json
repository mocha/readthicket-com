{
  "name": "readthicket-com",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "readthicket.com's own pages: the landing page and, later, pricing, legal and about. The app itself is github.com/mocha/thicket.",
  "scripts": {
