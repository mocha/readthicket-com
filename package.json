    "@types/nodemailer": "^8.0.2",
    "nodemailer": "^10.0.13",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
